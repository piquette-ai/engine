{
  // For `wrangler dev` and the Miniflare tests ONLY. A real deploy is `spf cloud deploy`, which generates its
  // own config from the layered spf.config.yaml; nothing here is deployment-specific (placeholders only).
  "name": "spf",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // NO nodejs_compat: the build must fail if a node: import sneaks into a module.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    // Load-bearing: without it files in web/ are served without going through the Worker, so they skip the JWT check.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [{ "binding": "RECEIPTS", "bucket_name": "spf-receipts" }],
  "d1_databases": [{ "binding": "DB", "database_name": "spf-hub", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "SPF_MODULES": "receipts",
    "BASE_PATH": "/",
    "RECEIPTS_PREFIX": "",
    "RETENTION_DAYS": "90",
    "CHROME_STYLESHEET_URL": "",
    "CHROME_HEADER_URL": "",
    "CHROME_HEADER_HEIGHT": "56",
    "CHROME_HOME_URL": ""
  },
  "observability": { "enabled": true }
}
